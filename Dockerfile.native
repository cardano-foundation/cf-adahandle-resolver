# GraalVM native image of the resolver. Built and smoke-tested weekly by .github/workflows/native-image.yaml, and
# published with each release as cardanofoundation/adahandle-resolver:<version>-native.
#
#   docker build -f Dockerfile.native -t adahandle-resolver:native .
#
# Built with Oracle GraalVM, like cf-token-metadata-registry (ADR-003) and yaci-store's native
# releases. Oracle GraalVM is licensed under the GraalVM Free Terms and Conditions (GFTC): free use,
# including production and hosted/paid services, and free redistribution. The GraalVM parts compiled
# into the binary count as the GraalVM program, so the image ships Oracle's license and notices in
# /licenses/graalvm (the GFTC requires keeping them). The resolver itself is MIT (/licenses/LICENSE).
#
# The version is pinned so a GraalVM update (or a change of its license terms) is a reviewed change.
#
# The trust store (cacerts) is Eclipse Temurin's latest JDK 25, like the JVM image's. native-image embeds the
# build JDK's cacerts in the binary, so it is replaced before the build. Since 25.0.5+8, Temurin drops the roots
# that signed the compromised eMudhra intermediate CAs: https://adoptium.net/news/2026/10/temurin-october-2026-emudhra/
FROM eclipse-temurin:25-jre-noble AS cacerts

FROM container-registry.oracle.com/graalvm/native-image:25i5-25.0.5.0.3-ol9 AS build

# The Maven wrapper downloads Maven with curl and unpacks it with tar.
RUN microdnf install -y findutils curl tar gzip && microdnf clean all

WORKDIR /app
COPY pom.xml /app/pom.xml
COPY mvnw /app/mvnw
COPY .mvn /app/.mvn

COPY --from=cacerts /opt/java/openjdk/lib/security/cacerts $JAVA_HOME/lib/security/cacerts
# Fail the build if the trust store still trusts the roots removed for eMudhra.
RUN ! keytool -list -v -cacerts -storepass changeit | grep -E "^Owner: .*CN=(emSign ECC Root CA - G3|AAA Certificate Services)\b"

RUN ./mvnw -B -Pnative verify clean --fail-never
COPY . /app
# In a git worktree, .git is a file pointing to the main checkout, which isn't copied: drop it so the build runs
# as without git (no commit on /actuator/info) instead of failing. A normal checkout's .git directory stays.
RUN if [ -f .git ]; then rm .git; fi
RUN ./mvnw -B -Pnative -DskipTests package

RUN mkdir -p /licenses/graalvm \
    && cp "$JAVA_HOME/LICENSE.txt" /licenses/graalvm/LICENSE.txt \
    && cp "$JAVA_HOME/NOTICE.txt" /licenses/graalvm/NOTICE.txt

# Debian's amd64 baseline is x86-64 (v1), so with -march=compatibility the image also runs on
# older CPUs and generic VM CPU models.
FROM debian:trixie-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends zlib1g curl \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.licenses="MIT AND LicenseRef-GraalVM-Free-Terms-and-Conditions"

WORKDIR /app
COPY --from=build /licenses /licenses
COPY LICENSE /licenses/LICENSE
COPY --from=build /app/target/adahandle-resolver /app/adahandle-resolver
# The API port (server.port, PORT); change it here too if PORT is changed.
EXPOSE 9095
ENTRYPOINT ["/app/adahandle-resolver"]
# A native binary ignores JAVA_TOOL_OPTIONS; runtime flags go on the command line (e.g. add -Xmx to
# cap the heap). networkaddress.cache.ttl=0 re-resolves the relay hostname on every reconnect.
CMD ["-Dnetworkaddress.cache.ttl=0", "-Dnetworkaddress.cache.negative.ttl=0"]
